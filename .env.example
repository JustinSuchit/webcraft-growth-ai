# ---- Required for live mode (leave Supabase unset to run in demo mode) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the browser
APP_URL=http://localhost:3000       # public base URL (OAuth redirects, unsubscribe links)
STATE_SIGNING_SECRET=               # 32+ random chars: `openssl rand -base64 48`
CRON_SECRET=                        # 16+ random chars; Vercel sends it to /api/cron/*

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5   # research, drafting, content
ANTHROPIC_MODEL_FAST=claude-haiku-5-5  # summaries

# ---- Email: Gmail API (recommended; enables reply monitoring) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ---- or authenticated SMTP (send-only) ----
SMTP_URL=                           # smtps://user:app-password@smtp.example.com:465

# ---- Instagram (Meta) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# ---- Images ----
IMAGE_PROVIDER=template             # template | openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
